{
  "name": "PnP Cards",
  "short_name": "PnP Cards",
  "description": "Crea PDF de cartas print and play listos para imprimir y recortar.",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef1ee",
  "theme_color": "#1e5b47",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/x-pnpcards": [".pnpcards"] },
      "icons": [{ "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
